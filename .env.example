# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite file — works as-is, no Turso needed)
DATABASE_URL="file:./dev.db"

# Production (Turso — get from https://turso.tech)
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Full URL of your deployed app (no trailing slash)
NEXTAUTH_URL="https://your-domain.vercel.app"
# Random secret: run `openssl rand -base64 32` in terminal
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ─── Admin Credentials ───────────────────────────────────────────────────────
# Admin login email
ADMIN_EMAIL="you@example.com"
# bcrypt hash of your admin password
# Generate: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2a$12$..."

# ─── Email (choose one provider) ─────────────────────────────────────────────
MAIL_PROVIDER="resend"         # "resend" or "smtp"

# If using Resend (recommended — free tier at https://resend.com)
RESEND_API_KEY="re_..."

# If using Gmail SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"

# Sender address shown in emails
SMTP_FROM="Raghav Mahajan <you@yourdomain.com>"
# Where contact form submissions get emailed
CONTACT_RECEIVER_EMAIL="you@example.com"

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Used in unsubscribe links and OG metadata
NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
