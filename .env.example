# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite file — works as-is, no Turso needed)
DATABASE_URL="file:./dev.db"

# Production (Turso — get from https://turso.tech)
# DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# ─── Supabase (logins, client portal, invoices) ──────────────────────────────
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Admin two-factor ────────────────────────────────────────────────────────
# 32 random bytes: run `openssl rand -base64 32`. Keep a backup: losing it means re-enrolling 2FA.
MFA_ENCRYPTION_KEY="your-32-byte-base64-key"

# ─── CSRF & IP Hashing ───────────────────────────────────────────────────────
# Random secrets: run `openssl rand -hex 32` for each
CSRF_SECRET="your-csrf-secret-here"
IP_HASH_SALT="your-ip-hash-salt-here"

# ─── Email (choose one provider) ─────────────────────────────────────────────
MAIL_PROVIDER="resend"         # "resend" or "smtp"

# If using Resend (recommended — free tier at https://resend.com)
RESEND_API_KEY="re_your_resend_api_key_here"

# If using Gmail SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"

# Sender address shown in emails
SMTP_FROM="Your Name <you@yourdomain.com>"
# Where contact form submissions get emailed
CONTACT_RECEIVER_EMAIL="you@example.com"

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Used in unsubscribe links and OG metadata
NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
